# ─────────────────────────────────────────────────────────
# Janar Kuusk Portfolio — environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. NEVER commit real keys.
# ─────────────────────────────────────────────────────────

# Google Gemini API key — powers the AI narrative on
# /roi-calculator and /ai-assessment (via /api/gemini).
# Free key: https://aistudio.google.com/app/apikey
# Without it the tools still work; only the AI section is disabled.
GEMINI_API_KEY=

# Resend API key — optional. Sends a notification email when someone
# unlocks the ROI PDF report (via /api/lead). Get one: https://resend.com
# Without it, leads are just logged server-side and the download still works.
RESEND_API_KEY=

# Plausible analytics domain — optional, cookieless (no consent banner
# needed, keeps the /privacy page's "no cookies" claim true). Sign up at
# https://plausible.io, add this site's domain, paste it here.
# Without it, no analytics script loads — the site works identically.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Formspree endpoint — required for the /contact form to actually submit.
# Public by design (Formspree endpoints are meant to be used client-side),
# kept as an env var for consistency with the rest of this file.
# Dashboard: https://formspree.io/forms
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Firebase service-account key — required to persist ROI-calculator leads to
# Firestore (project: janar-kuusk-pro-roi-calculator, database: leads).
# Console → Project Settings → Service Accounts → Generate new private key,
# then base64 the downloaded JSON file into this var, e.g.:
#   base64 -i service-account.json | tr -d '\n'
# Without it, leads just fail to persist (logged, non-blocking).
FIREBASE_SERVICE_ACCOUNT_KEY=
